{
	"name": "pi-openai-web-search",
	"version": "0.1.1",
	"description": "OpenAI Responses native web search policy extension for the pi coding agent. Ensures native web_search tools are present on openai-responses and azure-openai-responses payloads and appends web search guidance to the system prompt.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/pi-openai-web-search",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/pi-openai-web-search.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/pi-openai-web-search/issues"
	},
	"keywords": [
		"pi",
		"pi-mono",
		"pi-coding-agent",
		"pi-extension",
		"coding-agent",
		"openai",
		"web-search",
		"responses-api",
		"typescript"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "bun run typecheck",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsgo --noEmit && biome check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/node": "26.6.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
